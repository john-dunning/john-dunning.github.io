---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/Section.astro";
import SectionItem from "@/components/SectionItem.astro";
import HomeSidebar from "@/components/HomeSidebar.astro";
import HighlightedCommands from "@/components/HighlightedCommands.astro";
import quickeyThumb from "@/assets/home/quickey.png";
import yalpfThumb from "@/assets/yalpf/md/frame-in-london.jpg";

const sections = [
	{ title: "github", href: "https://github.com/fwextensions" },
	{ title: "yalpf", href: "/yalpf/" },
	{ title: "fireworks", href: "/fireworks/" },
	{ title: "archive", href: "/archive/core-frames.html?Portfolio" },
];
---

<Layout>
	<HomeSidebar slot="sidebar" sections={sections} />

	<Section
		index={1}
		title="github"
		href="https://github.com/fwextensions"
	>
		<p slot="description">
			Coding side projects in various states of completion.
		</p>

		<SectionItem
			title="QuicKey"
			href="https://github.com/fwextensions/QuicKey"
		>
			<Image slot="thumb" src={quickeyThumb} width="240" alt="" />
			A 5-star-rated <a href="https://chrome.google.com/webstore/detail/quickey-%E2%80%93-the-quick-tab-s/ldlghkoiihaelfnggonhjnfiabmaficg">Chrome extension</a> for
			switching tabs with a Quicksilver-style search or a most recently used menu.

			<Fragment slot="extra">
				<a href="https://fwextensions.github.io/QuicKey/">Homepage</a>
				<a href="https://chrome.google.com/webstore/detail/quickey-%E2%80%93-the-quick-tab-s/ldlghkoiihaelfnggonhjnfiabmaficg">Chrome Web Store</a>
			</Fragment>
		</SectionItem>

		<SectionItem
			title="wagtail-mcp"
			href="https://github.com/fwextensions/wagtail-mcp"
		>
			A basic MCP server that provides an LLM with read-only access to a Wagtail CMS instance.

			<Fragment slot="extra">
				<a href="https://www.npmjs.com/package/wagtail-mcp"><code>npm i wagtail-mcp</code></a>
			</Fragment>
		</SectionItem>

		<SectionItem
			title="fwidgets"
			href="https://github.com/fwextensions/fwidgets"
		>
			A library for adding basic UI functionality to a Figma plugin without
			writing any UI code. Think of it like adding a series of interactive
			prompts to a command line tool, similar to the wizard structure of
			something like <code>create-react-app</code>. fwidgets lets you show one
			UI element at a time to the user, awaiting their input and then responding
			to it, while keeping all of your code in the main thread.

			<Fragment slot="extra">
				<a href="https://www.npmjs.com/package/fwidgets"><code>npm i fwidgets</code></a>
			</Fragment>
		</SectionItem>

		<SectionItem
			title="figma-await-ipc"
			href="https://github.com/fwextensions/figma-await-ipc"
		>
			A simple <code>await</code>-able replacement for <code>postMessage()</code> in Figma plugins.

			<Fragment slot="extra">
				<a href="https://www.npmjs.com/package/figma-await-ipc"><code>npm i figma-await-ipc</code></a>
			</Fragment>
		</SectionItem>

		<SectionItem
			title="quick-score"
			href="https://github.com/fwextensions/quick-score"
		>
			A string-scoring and fuzzy-matching library. It's based on the algorithm
			used in the Quicksilver macOS utility and is designed for smart
			auto-complete. It improves on the original algorithm by tuning the scoring
			for long strings, such as webpage titles or URLs, so that the order of the
			results makes more sense for a given search string.

			<Fragment slot="extra">
				<a href="https://fwextensions.github.io/quick-score-demo/">Demo</a>
				<a href="https://www.npmjs.com/package/quick-score"><code>npm i quick-score</code></a>
			</Fragment>
		</SectionItem>

		<li class="see-all ui">
			<a href="https://github.com/fwextensions?tab=repositories">See all the repos &rarr;</a>
		</li>
	</Section>

	<Section
		index={2}
		title="yalpf"
		href="/yalpf/"
	>
		<Image slot="thumb" src={yalpfThumb} width="240" alt="" />
		<p slot="description">
			Yet another laptop picture frame build log. An old Dell, a custom
			frame, and software that pulled new photos down for five years until
			Hurricane Sandy got to it.
		</p>
	</Section>

	<HighlightedCommands index={3} />

	<Section
		index={4}
		title="archive"
		href="/archive/core-frames.html?Portfolio"
	>
		<p slot="description">
			Some really old stuff.  (Like, <em>framesets</em> old.  Like, special handling for <em>Netscape Navigator</em> old.)
		</p>
	</Section>
</Layout>

<style>
	.see-all {
		margin-top: var(--spacing-sm);
	}
</style>
