---
import { base } from "@/utils/urls.ts";

	// filter the split pathname to ignore leading or trailing slashes.  also
	// remove any base URL when showing the section.  we'll add it back in via
	// base() below.
const [section, ...restOfPath] = Astro.url.pathname
	.replace(new RegExp(`^${import.meta.env.BASE_URL}`), "")
	.split("/")
	.filter(Boolean);
---

<header>
	<a class="site-name" href={base("/")} aria-current={section ? undefined : "page"}>
		john<strong>dunning</strong>.com<span class="slash">/</span>
	</a>
	{section &&
		<a class="section" href={base(`/${section}/`)} aria-current={restOfPath.length ? undefined : "page"}>{section}</a>
	}
</header>

<style lang="scss">
	header {
		grid-column: 1 / -1;
		grid-row: 1;
		font-family: var(--font-display);
		font-stretch: 90%;
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1;
		color: var(--header-secondary);
		margin: 1.5rem 0 2.5rem 0;
		white-space: nowrap;

		& a[aria-current] {
			pointer-events: none;
		}

		& a:hover {
			text-decoration: none;
		}
	}

	.site-name {
		color: var(--header-secondary);

		& strong {
			color: var(--header-primary);
			font-weight: 800;
		}

		& .slash {
			color: var(--color-border);
			font-weight: 300;
			margin-left: .05em;
		}
	}

	.section {
		color: var(--text-color-accent);

		&:visited {
			color: var(--text-color-accent);
		}
	}
</style>
