---
import { base } from "@/utils/urls.ts";

	// filter the split pathname to ignore leading or trailing slashes.  also
	// remove any base URL when showing the section.  we'll add it back in via
	// base() below.
const [section, ...restOfPath] = Astro.url.pathname
	.replace(new RegExp(`^${import.meta.env.BASE_URL}`), "")
	.split("/")
	.filter(Boolean);
---

<header>
	<a class="site-name wordmark" href={base("/")} aria-current={section ? undefined : "page"}>
		john<strong>dunning</strong>.com/
	</a>
	{section &&
		<a class="section wordmark" href={base(`/${section}/`)} aria-current={restOfPath.length ? undefined : "page"}>{section}</a>
	}
</header>

<style lang="scss">
	header {
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		align-items: baseline;
		padding: var(--header-pad-top) 0 var(--header-pad-bottom) 0;
		background: var(--color-background);
		color: var(--header-secondary);

		& a[aria-current] {
			pointer-events: none;
		}

		& a:hover {
			text-decoration: none;
		}
	}

	.site-name {
		color: var(--header-secondary);

		& strong {
			color: var(--header-primary);
		}
	}

	.section {
		color: var(--text-color-accent);

		&:visited {
			color: var(--text-color-accent);
		}
	}

	@media (max-width: 720px) {
		header {
			position: static;
		}
	}
</style>
