---
import ParaWithMore from "./ParaWithMore.astro";

interface Props {
	title: string;
	href: string;
	addMore?: boolean;
}

const { title, href, addMore } = Astro.props;
const hasThumb = Astro.slots.has("thumb");
---

<li class:list={{ "has-thumb": hasThumb }}>
	{hasThumb &&
		<a class="thumb" href={href} tabindex="-1" aria-hidden="true">
			<slot name="thumb" />
		</a>
	}

	<div class="body">
		<h3>
			<a href={href}>{title}</a>
		</h3>

		<ParaWithMore href={addMore && href}>
			<slot />
		</ParaWithMore>

		{Astro.slots.has("extra") &&
			<p class="extra ui">
				<slot name="extra" />
			</p>
		}
	</div>
</li>

<style lang="scss">
	li {
		display: grid;
		grid-template-columns: var(--gutter-w) minmax(0, 1fr);
		margin: 0 0 var(--spacing-md) calc(-1 * var(--gutter-w));
	}

	.thumb {
		grid-column: 1;
		align-self: start;
		width: calc(var(--gutter-w) - 1.25rem);
		margin-top: .2rem;
		border: 1px solid var(--color-border);
		border-radius: 3px;
		overflow: hidden;
		background: var(--color-surface);
		line-height: 0;

		:global(img) {
			width: 100%;
			height: auto;
			display: block;
		}
	}

	.body {
		grid-column: 2;
		max-width: 38rem;
	}

	h3 {
		font-size: var(--text-md);
		font-weight: 600;
		margin-bottom: .25rem;
	}

	.body :global(p) {
		padding: 0;
	}

	.extra {
		margin-top: .35rem;
		color: var(--text-color-secondary);
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;

		:global(a) {
			color: var(--text-color-secondary);
			text-decoration: underline;
			text-decoration-color: var(--color-border);

			&:hover {
				color: var(--text-color-accent);
				text-decoration-color: currentColor;
			}
		}

		:global(code) {
			font-size: .9em;
			background: none;
			padding: 0;
			color: inherit;
		}
	}

	@media (max-width: 720px) {
		li {
			grid-template-columns: 1fr;
			margin-left: 0;
		}

		.thumb {
			display: none;
		}

		.body {
			grid-column: 1;
		}
	}
</style>
