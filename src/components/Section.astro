---
import { base } from "@/utils/urls.ts";

interface Props {
	title: string;
	href: string;
}

const { title, href } = Astro.props;
---

<article>
	<h2 class="wordmark" data-docking-title>
		<a href={base(href)}>{title}</a>
	</h2>

	<div class="gutter">
		{Astro.slots.has("thumb") &&
			<a class="thumb" href={base(href)} tabindex="-1" aria-hidden="true">
				<slot name="thumb" />
			</a>
		}
	</div>

	<div class="description">
		<slot name="description" />
	</div>

	<ul role="list">
		<slot />
	</ul>
</article>

<script>
		// section titles are sticky, and dock just after the slash in the
		// wordmark.  there's no CSS :stuck state, so watch each title with an
		// observer whose root is inset by the docking offset: once the title is
		// pinned there, it's partially outside the inset root
	const titles = document.querySelectorAll<HTMLElement>("[data-docking-title]");

	if (titles.length) {
		const top = parseFloat(getComputedStyle(titles[0]).top) || 0;
		const observer = new IntersectionObserver(
			(entries) => entries.forEach(({ target, intersectionRatio, boundingClientRect }) => {
				target.classList.toggle("docked", intersectionRatio < 1 && boundingClientRect.top <= top + 1);
			}),
			{ threshold: [1], rootMargin: `-${top + 1}px 0px 0px 0px` }
		);

		titles.forEach((title) => observer.observe(title));
	}
</script>

<style>
	article {
		position: relative;
		display: grid;
		grid-template-columns: var(--gutter-w) minmax(0, 1fr);
		grid-template-areas:
			"title title"
			"gutter description"
			"gutter items";
		margin-top: var(--spacing-xl);
		padding-top: var(--spacing-md);
		border-top: 1px solid var(--color-rule);
	}

	article:first-of-type {
		margin-top: 0;
		padding-top: var(--spacing-sm);
		border-top: none;
	}

	h2 {
		grid-area: title;
		position: sticky;
		top: var(--header-pad-top);
		z-index: 3;
		justify-self: start;
			/* leave at least the header's bottom padding below the title, so
			   the section content is still clear of the header band at the
			   moment the title docks */
		margin: 0 0 calc(var(--header-pad-bottom) + var(--spacing-sm)) 0;
		transition: color .2s;
	}

	h2.docked {
		color: var(--text-color-accent);
	}

	.gutter {
		grid-area: gutter;
		padding-top: .35rem;
		padding-right: 1.25rem;
	}

	.thumb {
		display: block;
		width: calc(var(--gutter-w) - 1.25rem);
		border: 1px solid var(--color-border);
		border-radius: 3px;
		overflow: hidden;
		background: var(--color-surface);
		line-height: 0;
	}

	.thumb :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.description {
		grid-area: description;
		font-size: var(--text-md);
		color: var(--text-color-muted);
		max-width: 38rem;
	}

	ul {
		grid-area: items;
		margin: var(--spacing-md) 0 0 0;
		padding: 0;
	}

	ul:empty {
		display: none;
	}

	@media (max-width: 720px) {
		article {
			grid-template-columns: 1fr;
			grid-template-areas:
				"title"
				"description"
				"items";
		}

		h2 {
			position: static;
		}

		.gutter {
			display: none;
		}
	}
</style>
