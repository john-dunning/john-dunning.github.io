---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<p>
	<slot />
	{ href && <a class="more-info ui" href={href}>more&hellip;</a> }
</p>

<style>
	p {
		padding: 0 var(--spacing-lg);
	}

	a.more-info {
		font-size: var(--text-xs);
		padding-left: .35rem;
		white-space: nowrap;
	}
</style>
